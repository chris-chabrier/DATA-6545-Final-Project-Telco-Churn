        "# Evaluate different classification thresholds for the original Gradient Boosting model\n",
        "\n",
        "thresholds = [0.30, 0.35, 0.40, 0.45, 0.50]\n",
        "\n",
        "threshold_results = []\n",
        "\n",
        "for threshold in thresholds:\n",
        "    y_pred_threshold = (y_prob_gb >= threshold).astype(int)\n",
        "\n",
        "    threshold_results.append({\n",
        "        \"Threshold\": threshold,\n",
        "        \"Accuracy\": accuracy_score(y_test_fe, y_pred_threshold),\n",
        "        \"Churn Precision\": precision_score(y_test_fe, y_pred_threshold),\n",
        "        \"Churn Recall\": recall_score(y_test_fe, y_pred_threshold),\n",
        "        \"Churn F1-Score\": f1_score(y_test_fe, y_pred_threshold),\n",
        "        \"False Positives\": confusion_matrix(y_test_fe, y_pred_threshold)[0, 1],\n",
        "        \"False Negatives\": confusion_matrix(y_test_fe, y_pred_threshold)[1, 0]\n",
        "    })\n",
        "\n",
        "threshold_results_df = pd.DataFrame(threshold_results)\n",
        "\n",
        "threshold_results_df"
      ]
