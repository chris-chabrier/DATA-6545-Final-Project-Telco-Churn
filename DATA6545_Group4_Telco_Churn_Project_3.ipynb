          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Training set shape: (5625, 35)\n",
            "Testing set shape: (1407, 35)\n"
          ]
        }
      ],
      "source": [
        "# Split the feature engineered data into training and testing sets\n",
        "\n",
        "X_train_fe, X_test_fe, y_train_fe, y_test_fe = train_test_split(\n",
        "    X_fe_encoded,\n",
        "    y_fe,\n",
        "    test_size=0.2,\n",
        "    random_state=42,\n",
        "    stratify=y_fe\n",
        ")\n",
        "\n",
        "print(\"Training set shape:\", X_train_fe.shape)\n",
        "print(\"Testing set shape:\", X_test_fe.shape)"
      ]
    },
