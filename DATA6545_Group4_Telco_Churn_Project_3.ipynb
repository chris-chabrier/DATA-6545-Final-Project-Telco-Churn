      "source": [
        "# Scale the features for logistic regression\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "scaler_fe = StandardScaler()\n",
        "\n",
        "X_train_fe_scaled = scaler_fe.fit_transform(X_train_fe)\n",
        "X_test_fe_scaled = scaler_fe.transform(X_test_fe)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "bP0J7gH-peFo"
      },
      "source": [
        "Feature scaling is applied because logistic regression is sensitive to differences in feature magnitude. Scaling helps the model treat features more consistently during training."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "QVx-uwXppn_H"
      },
      "outputs": [],
      "source": [
        "# Train logistic regression model with engineered features\n",
        "\n",
        "log_reg_fe = LogisticRegression(max_iter=1000, random_state=42)\n",
        "\n",
        "log_reg_fe.fit(X_train_fe_scaled, y_train_fe)\n",
        "\n",
        "# Generate predictions\n",
        "y_pred_fe = log_reg_fe.predict(X_test_fe_scaled)\n",
        "y_prob_fe = log_reg_fe.predict_proba(X_test_fe_scaled)[:, 1]"
      ]
