      "source": [
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score\n",
        "\n",
        "mlflow.set_experiment(\"telco-churn\")\n",
        "\n",
        "with mlflow.start_run(run_name=\"gb_model\"):\n",
        "\n",
        "    # Log model metadata\n",
        "    mlflow.log_param(\"model_type\", \"GradientBoostingClassifier\")\n",
        "    mlflow.log_param(\"encoding\", \"pd.get_dummies(drop_first=True)\")\n",
        "    mlflow.log_param(\"feature_set\", \"df_fe\")\n",
        "\n",
        "    # Log hyperparameters\n",
        "    gb_params = gb_model.get_params()\n",
        "\n",
        "    mlflow.log_param(\"n_estimators\", gb_params.get(\"n_estimators\"))\n",
        "    mlflow.log_param(\"learning_rate\", gb_params.get(\"learning_rate\"))\n",
        "    mlflow.log_param(\"max_depth\", gb_params.get(\"max_depth\"))\n",
        "    mlflow.log_param(\"random_state\", gb_params.get(\"random_state\"))\n",
        "\n",
        "    # Business threshold\n",
        "    mlflow.log_param(\"classification_threshold\", 0.35)\n",
        "\n",
        "    # Predictions\n",
        "    y_pred = gb_model.predict(X_test_fe)\n",
        "    y_prob = gb_model.predict_proba(X_test_fe)[:, 1]\n",
        "\n",
        "    # Apply business threshold\n",
        "    y_pred_threshold = (y_prob >= 0.35).astype(int)\n",
        "\n",
        "    # Metrics\n",
        "    mlflow.log_metric(\"accuracy\", accuracy_score(y_test_fe, y_pred))\n",
        "    mlflow.log_metric(\"precision\", precision_score(y_test_fe, y_pred))\n",
        "    mlflow.log_metric(\"recall\", recall_score(y_test_fe, y_pred))\n",
        "    mlflow.log_metric(\"f1\", f1_score(y_test_fe, y_pred))\n",
        "    mlflow.log_metric(\"roc_auc\", roc_auc_score(y_test_fe, y_prob))\n",
        "\n",
        "    # Threshold-based metrics\n",
        "    mlflow.log_metric(\"precision_at_0.35\", precision_score(y_test_fe, y_pred_threshold))\n",
        "    mlflow.log_metric(\"recall_at_0.35\", recall_score(y_test_fe, y_pred_threshold))\n",
        "    mlflow.log_metric(\"f1_at_0.35\", f1_score(y_test_fe, y_pred_threshold))\n",
        "\n",
        "    # Log model\n",
        "    mlflow.sklearn.log_model(gb_model, \"model\")"
      ]
